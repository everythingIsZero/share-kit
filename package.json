{
  "name": "@hxym18/share-kit",
  "version": "0.5.1",
  "description": "跨终端分享 SDK：环境决策（core）+ 浏览器适配（web）+ 海报配置（poster）+ DOM 渲染（render-dom）",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everythingIsZero/share-kit.git"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/core/index.d.ts",
      "import": "./src/core/index.mjs",
      "default": "./src/core/index.mjs"
    },
    "./web": {
      "types": "./src/web/index.d.ts",
      "import": "./src/web/index.mjs",
      "default": "./src/web/index.mjs"
    },
    "./poster": {
      "types": "./src/poster/index.d.ts",
      "import": "./src/poster/index.mjs",
      "default": "./src/poster/index.mjs"
    },
    "./render-dom": {
      "types": "./src/render-dom/index.d.ts",
      "import": "./src/render-dom/index.mjs",
      "default": "./src/render-dom/index.mjs"
    },
    "./node": {
      "types": "./src/node/index.d.ts",
      "import": "./src/node/index.mjs",
      "default": "./src/node/index.mjs"
    },
    "./ui": {
      "types": "./src/ui/index.d.ts",
      "import": "./src/ui/index.mjs",
      "default": "./src/ui/index.mjs"
    },
    "./web/react": {
      "types": "./src/web/react.d.ts",
      "import": "./src/web/react.mjs",
      "default": "./src/web/react.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "web": [
        "src/web/index.d.ts"
      ],
      "node": [
        "src/node/index.d.ts"
      ],
      "web/react": [
        "src/web/react.d.ts"
      ],
      "poster": [
        "src/poster/index.d.ts"
      ],
      "render-dom": [
        "src/render-dom/index.d.ts"
      ],
      "ui": [
        "src/ui/index.d.ts"
      ]
    }
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'",
    "test:download-bytes": "node test/e2e/download-bytes.mjs"
  },
  "dependencies": {
    "html2canvas-pro": "^1.5.8",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsqr": "^1.4.0"
  },
  "hxym18": {
    "contracts": {
      "sensitive-prefixes": "1+262b9b7c",
      "share-url-policy": "1+34c944cd",
      "capability-projection": "1+8f9e361b",
      "contracts": "1+189b5717"
    }
  }
}
